{
  "name": "agendapro-android",
  "version": "1.0.0",
  "private": true,
  "description": "AgendaPro Android wrapper built with Capacitor",
  "scripts": {
    "build:web": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www',{recursive:true});for(const f of ['index.html','manifest.json','sw.js','logo.jpg','logo.png'])if(fs.existsSync(f))fs.copyFileSync(f,'www/'+f)\"",
    "android:sync": "npm run build:web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
